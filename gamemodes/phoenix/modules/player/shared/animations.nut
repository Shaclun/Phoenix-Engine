	],
	byId = {},

	function initialize() {
		phoenix.player.AnimationsCatalog.byId = {}
		foreach (entry in phoenix.player.AnimationsCatalog.entries) phoenix.player.AnimationsCatalog.byId[entry.id] <- entry
	}

	function find(id) {
		if (id == null) return null
		local key = id.tostring()
		return key in phoenix.player.AnimationsCatalog.byId ? phoenix.player.AnimationsCatalog.byId[key] : null
	}

	function publicEntries() {
		local result = []
		foreach (entry in phoenix.player.AnimationsCatalog.entries) {
			result.append({ id = entry.id, category = entry.category, labelKey = entry.labelKey, playable = entry.playable, reason = entry.reason, stopOnMove = entry.stopOnMove })
		}
		return result
	}
}

phoenix.player.AnimationsCatalog.initialize()